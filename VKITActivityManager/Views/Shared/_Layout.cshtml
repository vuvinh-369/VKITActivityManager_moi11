<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VKIT University</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --vlu-red: #c62828;
            --vlu-dark: #1a237e;
        }

        body {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            overflow-x: hidden;
        }

        /* KHUNG MENU CHÍNH */
        .main-nav {
            background: #fff;
            border-bottom: 3px solid var(--vlu-red);
            padding: 8px 0;
            z-index: 1050;
        }

        /* Kích thước Logo tối ưu */
        .vkit-logo {
            height: 60px;
            object-fit: contain;
            mix-blend-mode: multiply;
            transition: all 0.3s ease;
        }

        /* DẢI BANNER ĐỎ BÊN DƯỚI MENU */
        .vlu-sub-header {
            position: relative;
            z-index: 999;
            background: var(--vlu-red);
            color: white;
            padding: 8px 0;
            font-weight: bold;
            text-align: center;
            font-size: 14px;
        }

        /* THIẾT KẾ NÚT BẤM MENU */
        .vlu-menu-link {
            color: var(--vlu-dark) !important;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 14px;
            letter-spacing: 0.5px;
            padding: 8px 16px !important;
            border-radius: 20px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }

            .vlu-menu-link:hover {
                background-color: var(--vlu-red);
                color: #ffffff !important;
                box-shadow: 0 4px 10px rgba(198, 40, 40, 0.2);
            }

        /* TÙY CHỈNH RESPONSIVE KHẮT KHE TRÊN ĐIỆN THOẠI */
        @@media (max-width: 991.98px) {
            .main-nav {
                height: 60px; /* Khóa cứng chiều cao thanh nav trên Mobile */
                padding: 0 !important;
            }
            .vkit-logo {
                height: 42px;
            }
            /* Áp dụng cấu trúc Grid chia 3 phần bằng chặn trên Mobile */
            .mobile-grid-header {
                display: grid !important;
                grid-template-columns: 1fr auto 1fr;
                align-items: center;
                width: 100%;
            }

            .navbar-collapse {
                background: #ffffff;
                padding: 15px;
                border-radius: 12px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.15);
                margin-top: 10px;
                border: 1px solid #eee;
                width: 100%;
            }

            .vlu-menu-link {
                width: 100%;
                margin-bottom: 5px;
                padding: 10px 20px !important;
                border-radius: 8px;
            }

            .vlu-sub-header {
                font-size: 12px;
            }
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-light main-nav shadow-sm py-2">
        <div class="container d-flex flex-wrap align-items-center justify-content-between">

            <div class="mobile-grid-header w-100 d-lg-none">

                <div class="text-start">
                    <a href="/" class="p-0 m-0 d-inline-block">
                        <img src="~/images/hoatdong/logoviethan.jpg" class="vkit-logo" />
                    </a>
                </div>

                <div class="d-flex flex-grow-1 justify-content-center align-items-center">
                    <h3 class="m-0 d-none d-lg-block fw-bold text-nowrap" style="font-size: 25px; letter-spacing: 1.2px; color: var(--vlu-dark);">
                        VIỆN CÔNG NGHỆ <span style="color: var(--vlu-red);">VIỆT HÀN</span>
                    </h3>
                    <h1 class="m-0 fw-bold d-lg-none text-nowrap" style="font-size: 14px; letter-spacing: 0.5px; color: var(--vlu-dark);">
                        VIỆN CÔNG NGHỆ <span style="color: var(--vlu-red);">VIỆT HÀN</span>
                    </h1>
                </div>

                <div class="text-end">
                    <button class="navbar-toggler border-0 shadow-none p-0" type="button" data-bs-toggle="collapse" data-bs-target="#vluNavbar" style="height: 42px; width: 42px; display: inline-flex; align-items: center; justify-content: flex-end;">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>

            </div>

            <a href="/" class="navbar-brand m-0 p-0 d-none d-lg-flex align-items-center">
                <img src="~/images/hoatdong/logoviethan.jpg" class="vkit-logo me-3" />
            </a>

            <div class="position-absolute start-50 top-50 translate-middle text-center d-none d-lg-block" style="pointer-events: none; z-index: 5; width: max-content;">
                <h3 class="m-0 fw-bold text-nowrap" style="font-size: 25px; letter-spacing: 1.2px; text-shadow: 1px 1px 2px rgba(0,0,0,0.05);">
                    <span style="color: var(--vlu-dark);">VIỆN CÔNG NGHỆ</span>
                    <span style="color: var(--vlu-red);">VIỆT HÀN</span>
                </h3>
            </div>
            @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin")
            {
                <a href="/" class="vlu-menu-link">
                    <i class="fas fa-home me-1"></i> Trang chủ
                </a>
            }
            

        </div>
    </nav>

    <div class="vlu-sub-header shadow-sm">
        <div class="container text-truncate">
            NĂNG ĐỘNG SÁNG TẠO <i class="fas fa-star mx-1 text-warning"></i> BỨT PHÁ TƯƠNG LAI
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="text-white pt-4 pb-3 mt-auto" style="background-color: #1a1a1a; font-size: 0.95rem;">
        <div class="container text-center">
            <div class="row">
                <div class="col-12 mx-auto">
                    <h5 class="fw-bold mb-3" style="color: #ffff; letter-spacing: 1px;">
                        VIỆN CÔNG NGHỆ VIỆT HÀN (VKIT) | TRƯỜNG ĐẠI HỌC CÔNG NGHỆ TP.HCM (HUTECH)
                    </h5>

                    <p class="mb-2">
                        <i class="fas fa-map-marker-alt me-2 text-danger"></i>
                        Trụ sở Điện Biên Phủ: 475A Điện Biên Phủ, Phường Thạnh Mỹ Tây, TP.HCM
                    </p>

                    <p class="mb-2 d-flex flex-wrap justify-content-center align-items-center gap-2 gap-md-3">
                        <span><i class="fas fa-phone-alt me-2" style="color: #4caf50;"></i>Điện thoại: (028) 3556 6109</span>
                        <span class="d-none d-md-inline text-secondary">|</span>
                        <span><i class="fas fa-comment-dots me-2" style="color: #0088cc;"></i>Zalo: 0397 953 837 (Thầy Thanh Vang)</span>
                        <span class="d-none d-md-inline text-secondary">|</span>
                        <span><i class="fas fa-envelope me-2" style="color: #ff9800;"></i>Email: vkit@hutech.edu.vn</span>
                    </p>

                    <p class="mb-3">
                        <i class="fas fa-globe me-2 text-primary"></i>Website:
                        <a href="https://hutech.edu.vn/VKIT" target="_blank" class="text-white text-decoration-none custom-link">
                            hutech.edu.vn/VKIT
                        </a>
                    </p>

                    <hr class="mb-3 mx-auto" style="border-color: #444; width: 80%;">

                    <div class="small" style="color: #aaa;">
                        &copy; @DateTime.Now.Year - Bản quyền thuộc về Viện Công Nghệ Việt Hàn (VKIT)
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <style>
        .custom-link {
            transition: color 0.3s ease;
        }

            .custom-link:hover {
                color: #f8ca00 !important;
                text-decoration: underline !important;
            }
    </style>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <div id="vkit-chat-btn" class="position-fixed d-flex align-items-center justify-content-center shadow-lg cursor-pointer"
         style="bottom: 30px; right: 30px; width: 65px; height: 65px; border-radius: 50%; background-color: #0d47a1; z-index: 9999; transition: transform 0.3s; cursor: pointer;">
        <i class="fas fa-comment-dots text-white fs-3"></i>
        <div class="position-absolute bg-white shadow-sm rounded p-2 text-center" style="right: 80px; width: 140px; font-size: 13px; font-weight: 600; border: 1px solid #e0e0e0;">
            <span class="text-primary">VKIT - Trợ lý ảo</span><br />
            <span class="text-danger">Tư vấn tuyển sinh</span>
            <div class="position-absolute" style="top: 50%; right: -6px; width: 12px; height: 12px; background: white; transform: translateY(-50%) rotate(45deg); border-right: 1px solid #e0e0e0; border-top: 1px solid #e0e0e0;"></div>
        </div>
    </div>

    <div id="vkit-chat-window" class="position-fixed shadow-lg rounded-4 bg-white d-none flex-column"
         style="bottom: 110px; right: 30px; width: 360px; height: 550px; z-index: 9999; border: 1px solid #e0e0e0; overflow: hidden;">

        <div class="bg-primary text-white p-3 d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #0d47a1, #1976d2) !important;">
            <div class="d-flex align-items-center">
                <div class="bg-white rounded-circle d-flex justify-content-center align-items-center text-primary fw-bold me-2" style="width: 35px; height: 35px;"><i class="fas fa-robot"></i></div>
                <h6 class="m-0 fw-bold">VKIT Admission Bot</h6>
            </div>
            <i class="fas fa-times cursor-pointer fs-5" id="close-chat" style="cursor: pointer;"></i>
        </div>

        <div id="chat-history" class="p-3 flex-grow-1" style="overflow-y: auto; background-color: #f4f7f6;">
            <div class="d-flex justify-content-start mb-3">
                <div class="bg-white p-3 rounded-3 shadow-sm" style="max-width: 85%; font-size: 14px; border: 1px solid #e9ecef;">
                    Chào bạn! 👋 Chào mừng bạn đến với Viện Công Nghệ Việt - Hàn (VKIT). Dưới đây là các chủ đề thường được quan tâm nhất. Hãy chọn một câu hỏi nhé!
                </div>
            </div>

            <div id="chatbox-questions" class="d-flex flex-wrap gap-2 mb-3">
            </div>
        </div>

        <div class="p-2 bg-light border-top text-center text-muted" style="font-size: 12px;">
            Hệ thống tư vấn tự động <i class="fas fa-bolt text-warning"></i> VKIT
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const chatBtn = document.getElementById('vkit-chat-btn');
            const chatWindow = document.getElementById('vkit-chat-window');
            const closeBtn = document.getElementById('close-chat');
            const questionsContainer = document.getElementById('chatbox-questions');
            let dataLoaded = false;

            // Bật / Tắt Chatbox
            chatBtn.addEventListener('click', function () {
                chatWindow.classList.toggle('d-none');
                chatWindow.classList.toggle('d-flex');

                // Lần đầu mở chatbox thì gọi API lấy câu hỏi từ CSDL
                if (!chatWindow.classList.contains('d-none') && !dataLoaded) {
                    fetch('/Home/GetChatboxData')
                        .then(response => response.json())
                        .then(data => {
                            dataLoaded = true;
                            if (data && data.length > 0) {
                                data.forEach(item => {
                                    // Tạo nút bấm cho mỗi câu hỏi
                                    let btn = document.createElement('button');
                                    btn.className = 'btn btn-outline-primary btn-sm rounded-pill text-start shadow-sm';
                                    btn.style.fontSize = '13px';
                                    btn.style.whiteSpace = 'normal';
                                    btn.innerText = item.cauHoi;

                                    // Khi User bấm vào câu hỏi
                                    btn.onclick = function() {
                                        appendMessage(item.cauHoi, 'user');
                                        // Giả lập bot gõ chữ trong 0.5s cho chân thực
                                        setTimeout(() => {
                                            appendMessage(item.traLoi, 'bot');
                                        }, 500);
                                    };
                                    questionsContainer.appendChild(btn);
                                });
                            }
                        })
                        .catch(err => console.log('Lỗi tải chatbox:', err));
                }
            });

            closeBtn.addEventListener('click', function () {
                chatWindow.classList.add('d-none');
                chatWindow.classList.remove('d-flex');
            });

            // Hàm in tin nhắn lên màn hình
            function appendMessage(text, sender) {
                const history = document.getElementById('chat-history');
                const msgDiv = document.createElement('div');
                msgDiv.className = sender === 'user' ? 'd-flex justify-content-end mb-3' : 'd-flex justify-content-start mb-3';

                let bubbleHtml = '';
                if (sender === 'user') {
                    bubbleHtml = `<div class="bg-primary text-white p-2 px-3 rounded-4 rounded-bottom-0 shadow-sm" style="max-width: 85%; font-size: 14px;">${text}</div>`;
                } else {
                    bubbleHtml = `<div class="bg-white text-dark p-3 rounded-4 shadow-sm" style="max-width: 85%; font-size: 14px; border: 1px solid #e9ecef;">${text}</div>`;
                }

                msgDiv.innerHTML = bubbleHtml;
                // Đẩy tin nhắn mới lên trước danh sách nút chọn câu hỏi
                history.insertBefore(msgDiv, questionsContainer);

                // Cuộn xuống cuối
                history.scrollTop = history.scrollHeight;
            }
        });
    </script>
</body>
</html>