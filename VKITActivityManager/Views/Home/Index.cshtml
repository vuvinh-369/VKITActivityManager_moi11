@if (videos.Count > 0)
{
    <script>
        const playlist = @Html.Raw(Json.Serialize(videos.Select(v => new { videoUrl = v.DuongDanVideo, title = v.TieuDe, subTitle = string.IsNullOrEmpty(v.TieuDe2) ? v.MoTaNgan : v.TieuDe2, content = v.NoiDung })));
        let currentIndex = 0, player;
        function getYouTubeId(url) {
            if (!url) return '';
            const match = url.match(/^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/);
            return (match && match[2].length === 11) ? match[2] : null;
        }
        var tag = document.createElement('script'); tag.src = "https://www.youtube.com/iframe_api";
        document.getElementsByTagName('script')[0].parentNode.insertBefore(tag, document.getElementsByTagName('script')[0]);
        function onYouTubeIframeAPIReady() {
            let firstVideoId = getYouTubeId(playlist[0].videoUrl);
            if (!firstVideoId) return;
            player = new YT.Player('youtubePlayerAPI', {
                height: '100%', width: '100%', videoId: firstVideoId, host: 'https://www.youtube-nocookie.com',
                playerVars: { 'playsinline': 1, 'autoplay': 1, 'mute': 1, 'rel': 0 },
                events: { 'onReady': onPlayerReady, 'onStateChange': (e) => { if (e.data === YT.PlayerState.ENDED) nextVideo(); } }
            });
        }
        function onPlayerReady(event) { updateTextContent(); event.target.playVideo(); }
        function updateTextContent() {
            document.getElementById('currentVideoTitle').innerHTML = playlist[currentIndex].title;
        }
        function nextVideo() {
            currentIndex = (currentIndex + 1) >= playlist.length ? 0 : currentIndex + 1;
            let nextId = getYouTubeId(playlist[currentIndex].videoUrl);
            if(nextId && player) { player.loadVideoById(nextId); updateTextContent(); }
        }
    </script>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var pressEl = document.querySelector('#pressSlider');
        if (pressEl) {
            var pCarousel = new bootstrap.Carousel(pressEl, {
                interval: 3500,
                wrap: true,
                pause: 'hover'
            });
            pCarousel.cycle();
