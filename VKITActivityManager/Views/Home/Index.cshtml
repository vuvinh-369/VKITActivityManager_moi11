    .hb-premium-card {
        display: flex;
        align-items: stretch;
        background-color: var(--hb-color, #4a72d4);
        border-radius: 8px; /* Bo góc như ảnh */
        margin-bottom: 12px;
        cursor: pointer;
        position: relative;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.05);
        text-decoration: none !important;
    }

        .hb-premium-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        }

    .hb-premium-left {
        width: 120px;
        /* Dùng nền đen mờ 20% đè lên màu thẻ để tạo dải màu đậm bên trái tự động */
        background: rgba(0, 0, 0, 0.2);
        /* Cắt hình chevron nhọn sang phải */
        clip-path: polygon(0 0, calc(100% - 15px) 0, 100% 50%, calc(100% - 15px) 100%, 0 100%);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding-right: 15px;
        flex-shrink: 0;
    }

    .hb-premium-num {
        font-size: 38px !important;
        font-weight: 900 !important;
        color: #ffffff !important;
        line-height: 1 !important;
        margin: 0 0 2px 0 !important;
        font-family: 'Arial Black', Impact, sans-serif !important;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
    }

    .hb-premium-unit {
        font-size: 13px !important;
        font-weight: 700 !important;
        color: #ffffff !important;
        text-transform: uppercase !important;
        letter-spacing: 1.5px !important;
        margin: 0 !important;
    }

    .hb-premium-right {
        flex-grow: 1;
        padding: 18px 50px 18px 20px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .hb-premium-title {
        font-size: 18px !important;
        font-weight: 800 !important;
        color: #ffffff !important;
        text-transform: uppercase !important;
        margin: 0 0 4px 0 !important;
        letter-spacing: 0.5px !important;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
    }

    .hb-premium-desc {
        font-size: 14px !important;
        font-style: italic !important;
        color: rgba(255, 255, 255, 0.9) !important;
        margin: 0 !important;
    }

    .hb-premium-icon {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 24px;
        color: rgba(255,255,255,0.4);
        transition: right 0.3s ease, color 0.3s ease;
    }

    .hb-premium-card:hover .hb-premium-icon {
        right: 15px;
        color: rgba(255,255,255,0.8);
    }

    /* MOBILE CSS */
    @@media (max-width: 768px) {
