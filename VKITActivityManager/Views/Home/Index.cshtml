    .section-badge {
    display: inline-flex;
    align-items: center;
    background: #F0F5FF; /* Xanh pastel siêu nhạt */
    color: #3B82F6;
    padding: 6px 16px;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 20px; /* Đẩy tiêu đề xuống không cho dính vào nhau */
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: #1E293B; /* Xanh đen sẫm chuẩn gốc */
        margin-bottom: 15px;
        display: block; /* Ép xuống dòng */
    }

    .section-subtitle {
        max-width: 650px;
        margin: 0 auto 40px auto; /* Tăng khoảng cách với các thẻ ở dưới */
        color: #64748B;
        font-size: 1rem;
        line-height: 1.6;
    }

    /* 2. Thiết lập bộ đếm số tự động cho thẻ */
    .advantages-section {
        counter-reset: card-counter; /* Khởi tạo bộ đếm số thứ tự */
    }

    .advantage-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 35px 28px;
        text-align: left; /* Trả về căn trái đúng ảnh gốc */
        border: 1px solid #F1F5F9;
        position: relative;
        overflow: hidden;
        height: 100%;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02); 
        transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        flex-direction: column;
        counter-increment: card-counter; /* Tự động tăng số đếm (1, 2, 3...) */
        z-index: 1;
    }

    /* Tự động in số thứ tự 01, 02 siêu to chìm ở góc phải */
    .advantage-card::before {
        content: "0" counter(card-counter); /* Thêm số 0 đằng trước */
        position: absolute;
        top: 25px;
        right: 25px;
        font-size: 4rem; /* Cỡ chữ to khổng lồ */
        font-weight: 800;
        color: #F8FAFC; /* Màu xám siêu nhạt tàng hình */
        z-index: -1; /* Ép chìm xuống dưới chữ */
        line-height: 1;
        display: block;
        background: transparent; /* Xóa dải màu đỏ gắt ở phiên bản trước */
        height: auto;
        width: auto;
    }

    .advantage-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 40px rgba(10, 37, 64, 0.08);
        border-color: rgba(67, 56, 202, 0.2); /* Viền ánh tím nhẹ khi hover */
    }

    /* 3. Sửa lại màu Icon sang tone Tím/Xanh chuẩn ảnh gốc */
    .advantage-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 24px;
        background-color: #EEF2FF !important; /* Tím pastel dịu mắt */
        color: #4F46E5 !important; /* Icon tím/xanh đậm */
        transition: all 0.3s ease;
        box-shadow: none;
    }

    /* Luân phiên đổi màu nền icon thành Hồng pastel nhẹ để giống ảnh gốc nhất */
    .advantage-card:nth-child(even) .advantage-icon {
        background-color: #FFF1F2 !important; 
        color: #E11D48 !important;
    }

    .advantage-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1E293B;
        margin-bottom: 12px;
        position: relative;
        padding-bottom: 8px;
        min-height: auto;
    }

    /* Gạch dưới tiêu đề */
    .advantage-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 24px;
        height: 2px;
        background-color: #E2E8F0;
        transition: all 0.3s ease;
    }

    .advantage-card:hover .advantage-title::after {
        background-color: #4F46E5; /* Khi hover gạch dưới chuyển màu tím */
        width: 40px;
    }

    .advantage-text {
        color: #475569;
        font-size: 0.95rem;
        line-height: 1.6;
        margin: 0;
    }

    /*Thêm*/
   
    .advantages-section {
    position: relative; 
    padding: 80px 0;
    background-color: #F8FAFC; /* Màu nền nhạt cho toàn khu vực */
    z-index: 1;
    overflow: hidden; /* Giúp cành hoa không bị tràn ra ngoài khung web */
}

    /* Lớp phủ chứa cành hoa đào */
    .advantages-section::before {
        content: "";
        position: absolute;
        top: -10px;        /* Sát mép trên (có thể chỉnh âm để giấu bớt cành góc) */
        left: -10px;       /* Sát mép trái */
        width: 400px;      /* Độ rộng hiển thị của cành hoa, tăng giảm tùy ý */
        height: 400px;
   
        background-image: url('/images/phongnen/hoa_anh_dao.png'); 
    
        background-size: contain; 
        background-position: left top; /* Canh sát góc trái trên cùng */
        background-repeat: no-repeat;
    
        /* Vì hoa nằm ở góc thoáng, bạn có thể để rõ nét một chút cho đẹp */
        opacity: 0.85; 
    
        z-index: -1;       /* Nằm dưới các ô nội dung để không che chữ */
        pointer-events: none; /* Tránh việc người dùng vô tình click nhầm vào ảnh */
    }

    /* Thanh vách ngăn bông hoa ở Tiêu đề phụ (Giữ lại cho đẹp giống bản gốc) */
    .section-subtitle {
        position: relative;
        padding-bottom: 30px; 
    }

    .section-subtitle::after {
        content: "✿"; 
        position: absolute;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        font-size: 20px;
        color: #93C5FD; 
    }

    .section-subtitle::before {
        content: "";
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%);
        width: 120px;
        height: 1px;
        background-color: #E2E8F0;
        z-index: -1;
    }

