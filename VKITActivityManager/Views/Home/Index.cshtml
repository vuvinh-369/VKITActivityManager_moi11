@model IEnumerable<VKITActivityManager.Models.HoatDong>
@{
    ViewData["Title"] = "Trang chủ - VKIT";
    var banners = Model.Where(x => x.PhanLoai == 3).OrderByDescending(x => x.NgayTao).ToList();
    var videos = Model.Where(x => x.PhanLoai == 2 && !string.IsNullOrEmpty(x.DuongDanVideo)).OrderByDescending(x => x.NgayTao).ToList();

    // TÁCH RÕ RÀNG DANH SÁCH DỰA VÀO MÃ PHÂN LOẠI
    var tinTucs = Model.Where(x => x.PhanLoai == 1).OrderByDescending(x => x.NgayTao).ToList();
    var hocBongs = Model.Where(x => x.PhanLoai == 4).OrderByDescending(x => x.NgayTao).ToList();
    var camNhans = Model.Where(x => x.PhanLoai == 5).OrderByDescending(x => x.NgayTao).ToList();
    var baoChis = Model.Where(x => x.PhanLoai == 6).OrderByDescending(x => x.NgayTao).ToList();
}

<style>
    /* BANNER CSS */
    .vlu-hero-carousel {
        width: 100vw;
        position: relative;
        left: 50%;
        right: 50%;
        margin-left: -50vw;
        margin-right: -50vw;
        background-color: #000;
    }

    .vlu-banner-img {
        width: 100%;
        height: calc(100vh - 110px);
        min-height: 400px;
        object-fit: cover;
        display: block;
    }

    .carousel-indicators [data-bs-target] {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        margin: 0 6px;
    }

    .carousel-indicators .active {
        background-color: #c62828;
        transform: scale(1.2);
    }

    /* CẢM NHẬN SINH VIÊN */
    .testimonial-section {
        background-color: #f8f9fa;
        border-radius: 30px;
        padding: 60px 30px;
        margin-top: 60px;
        margin-bottom: 50px;
    }

    .testimonial-title {
        color: #c62828;
        font-size: 2rem;
        font-weight: bold;
        text-align: center;
        text-transform: uppercase;
        margin-bottom: 50px;
    }

    .testimonial-img-wrapper {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        border: 4px solid #800000;
        padding: 5px;
        background: white;
        flex-shrink: 0;
        margin-right: 25px;
        box-shadow: 0 8px 15px rgba(0,0,0,0.1);
    }

    .testimonial-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
    }

    .testimonial-name {
        color: #d35400;
        font-size: 1.4rem;
        font-weight: bold;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

        .testimonial-name p, .testimonial-role p {
            display: inline;
            margin: 0;
            padding: 0;
        }

    .testimonial-role {
        color: #666;
        font-style: italic;
        font-size: 0.95rem;
        margin-bottom: 15px;
    }

    .testimonial-content {
        color: #333;
        font-size: 1rem;
        line-height: 1.7;
        text-align: justify;
    }

    .testimonial-nav-btn {
        background-color: #e65100;
        border: none;
        color: white;
        border-radius: 50%;
        width: 45px;
        height: 45px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.3s;
    }

        .testimonial-nav-btn:hover {
            background-color: #c62828;
        }

    /* BÁO CHÍ */
    .press-section {
        background-color: #f8f9fa;
        border-radius: 30px;
        padding: 60px 20px;
        margin: 50px 0;
    }

    .press-title {
        color: #c62828;
        font-size: 2rem;
        font-weight: bold;
        text-align: center;
        text-transform: uppercase;
        margin-bottom: 50px;
    }

    .press-card {
        background: #fff;
        border-radius: 15px;
        overflow: hidden;
        transition: 0.3s;
        border: 1px solid #eee;
        height: 100%;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
    }

        .press-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
            border-color: #c62828;
        }

    .press-img-container {
        height: 500px;
        width: 100%;
        overflow: hidden;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .press-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top center;
        image-rendering: high-quality;
        border-bottom: 1px solid #f0f0f0;
    }

    .press-name {
        font-size: 1.3rem;
        font-weight: bold;
        color: #333;
        padding: 25px 15px;
        text-align: center;
        flex-grow: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .press-control {
        width: 55px;
        height: 55px;
        background: #555;
        border-radius: 50%;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0.9;
    }

        .press-control:hover {
            background: #c62828;
            opacity: 1;
        }

    /* VIDEO CSS */
    .video-main-container {
        background-color: #ffffff;
        border-radius: 24px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.05);
        padding: 30px;
    }

    .video-player-wrapper {
        border-radius: 20px;
        overflow: hidden;
        background-color: #000;
        position: relative;
        box-shadow: 0 5px 20px rgba(0,0,0,0.15);
    }

    .youtube-container {
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        overflow: hidden;
        max-width: 100%;
        background: #000;
    }

        .youtube-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }

    .video-content-scroll {
        max-height: 220px;
        overflow-y: auto;
        padding-right: 8px;
    }

    /* TIN TỨC, HỌC BỔNG, ƯU ĐIỂM, ĐÀO TẠO, HỌC PHÍ... */
    .news-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .news-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
        }

    .training-section {
        background-color: #f8f9fa;
        border-radius: 20px;
        padding: 50px 30px;
    }

    .training-title {
        color: #1a237e;
        font-size: 2.2rem;
        line-height: 1.3;
    }

    .category-title {
        font-size: 1.15rem;
        color: #222;
    }

    .faculty-list {
        margin-top: 10px;
        padding-left: 35px;
    }

        .faculty-list li {
            margin-bottom: 8px;
        }

        .faculty-list a {
            color: #666;
            text-decoration: none;
            font-size: 0.95rem;
            transition: color 0.2s ease;
        }

            .faculty-list a:hover {
                color: #c62828;
                text-decoration: underline;
            }
    /* CSS TÙY CHỈNH CHO TAB HỌC PHÍ TRÔNG HIỆN ĐẠI HƠN */
    .tuition-tabs-container {
