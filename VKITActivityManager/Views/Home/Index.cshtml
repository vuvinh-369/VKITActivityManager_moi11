     @{
        // 1. LẤY TOÀN BỘ DANH SÁCH HỌC PHÍ, KHÔNG PHÂN CHIA HỆ CỬ NHÂN / KỸ SƯ NỮA
        var allHocPhi = ViewBag.DanhSachHocPhi as List<VKITActivityManager.Models.HocPhi> ?? new List<VKITActivityManager.Models.HocPhi>();
    
        // 2. GOM NHÓM LẠI THEO NGÀNH VÀ THỜI GIAN HỌC
        var groups = allHocPhi.GroupBy(x => new { x.NganhDaoTao, x.ThoiGian }).ToList();
    }

    <div class="tuition-section">
        <!-- Tiêu đề vùng học phí giữ nguyên -->
        <h2 class="fw-bold text-center tuition-title mb-5">
            HỌC PHÍ THAM KHẢO NĂM 2025 VÀ<br />ĐƯỢC TÍNH THEO CHƯƠNG TRÌNH ĐÀO TẠO CHUẨN
        </h2>

        @if (groups.Any())
        {
            <!-- Danh sách các Ngành dạng Xổ xuống (Bootstrap Accordion) -->
            <div class="accordion shadow-sm" id="accordionHocPhi" style="border-radius: 12px; overflow: hidden;">
                @{ int idx = 0; }
                @foreach (var group in groups)
                {
                    var collapseId = "collapse_" + idx;
                    var headingId = "heading_" + idx;
                    var items = group.ToList();

                    <div class="accordion-item border-0 border-bottom">
                    
                        <!-- BƯỚC 1: CHỈ HIỆN TÊN NGÀNH VÀ THỜI GIAN HỌC (Luôn hiển thị) -->
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button collapsed fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId" style="font-size: 1.1rem; color: #1a237e; background-color: #f8fafc;">
                                <i class="fas fa-graduation-cap me-2"></i> @group.Key.NganhDaoTao
                                <span class="badge bg-secondary ms-3" style="font-size: 0.8rem; font-weight: normal;">
                                    Thời gian học: @group.Key.ThoiGian
                                </span>
                            </button>
                        </h2>

                        <!-- BƯỚC 2: CLICK VÀO SẼ HIỆN RA GIAO DIỆN BẢNG CHI TIẾT HỌC PHÍ -->
                        <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#accordionHocPhi">
                            <div class="accordion-body p-4 bg-white">
                                <div class="table-responsive">
                                    <table class="table table-bordered text-center align-middle mb-0">
                                        <thead style="background-color: #1a237e; color: white;">
                                            <tr>
                                                <th width="25%">Đơn vị áp dụng</th>
                                                <th width="25%">Học phí<br />(VNĐ)</th>
                                                <th width="25%">Học phí sau học bổng 25%<br />(VNĐ)</th>
                                                <th width="25%">Học phí sau học bổng 50%<br />(VNĐ)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in items)
                                            {
                                                <tr class="@(item.LaDongPhu ? "bg-light-red" : "")">
                                                    <td class="text-dark-blue fw-bold">@item.DonViApDung</td>
                                                    <td class="text-blue fw-bold">@item.MucHocPhi</td>
                                                    <td class="text-red fw-bold">@item.HocPhiGiam25</td>
                                                    <td class="text-red fw-bold">@item.HocPhiGiam50</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                    </div>
                    idx++;
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted fst-italic card shadow-sm border-0">
                Chưa có thông tin học phí các ngành đào tạo.
            </div>
        }
    </div>


    <div class="vkit-scholarship-section py-5 my-4">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between mb-5 position-relative">
                <div class="title-wrapper">
                    <span class="text-uppercase fw-bold text-primary tracking-wider small d-block mb-1" style="letter-spacing: 2px; color: #4f46e5 !important;">VKIT SCHOLARSHIP FUND</span>
                    <h2 class="fw-black m-0" style="color: #0f172a; font-weight: 800; font-size: 2rem;">
                        Các Loại Học Bổng Hiện Hành Năm 2025
                    </h2>
                </div>
                <div class="title-line d-none d-md-block flex-grow-1 mx-4" style="height: 1px; background: linear-gradient(90deg, #e2e8f0, transparent);"></div>
            </div>

            <div class="row g-4 justify-content-center">
                @if (ViewBag.DanhSachLoaiHocBong != null)
                {
                    var dsLoaiHB = (List<VKITActivityManager.Models.LoaiHocBong>)ViewBag.DanhSachLoaiHocBong;

                    foreach (var item in dsLoaiHB)
                    {
                        string cardColor = !string.IsNullOrEmpty(item.MauNen) ? item.MauNen : "#4a72d4";

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 border-0 kor-scholarship-card position-relative" 
                                 style="--hb-color: @cardColor;"
                                 onclick="window.location.href='@Url.Action("DanhSachSinhVienHocBong", "Home", new { id = item.Id })'">
                            
                                <div class="card-color-bar" style="background: linear-gradient(135deg, var(--hb-color), #ffffff);"></div>
                            
                                <div class="card-body p-4 d-flex flex-column justify-content-between position-relative z-1">
                                    <div>
                                        <div class="d-flex align-items-center justify-content-between mb-4">
                                            <div class="kor-badge" style="background-color: var(--hb-color);">
                                                <i class="fas fa-award me-1"></i>
                                                @(item.SoSuat < 10 ? "0" + item.SoSuat : item.SoSuat.ToString()) SUẤT
                                            </div>
                                        </div>

                                        <h4 class="card-title fw-bold text-dark mb-3 kor-card-title">@item.TenHocBong</h4>
                                        <div class="w-25 my-3" style="height: 2px; background-color: var(--hb-color); opacity: 0.3;"></div>

                                        @if (!string.IsNullOrEmpty(item.MoTa))
                                        {
                                            <p class="card-text text-muted small kor-card-desc mb-4">@item.MoTa</p>
                                        }
                                    </div>

                                    <div class="pt-2">
                                        <div class="btn w-100 fw-bold d-flex align-items-center justify-content-center kor-btn-submit" 
                                             style="--btn-color: var(--hb-color);">
                                            <span>Xem danh sách vinh danh</span>
                                            <i class="fas fa-arrow-right ms-2 kor-arrow"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @if (camNhans.Count > 0)
    {
        <div class="testimonial-section shadow-sm">
            <h2 class="testimonial-title">CẢM NHẬN CỦA SINH VIÊN VỀ CHƯƠNG TRÌNH VIỆT - HÀN</h2>
            <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner px-md-4">
                    @for (int i = 0; i < camNhans.Count; i += 2)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="row g-4 justify-content-center align-items-center">
                                <div class="col-12 col-md-6">
                                    <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start px-3">
                                        <div class="testimonial-img-wrapper mb-3 mb-sm-0">
                                            <img src="@camNhans[i].DuongDanAnh" class="testimonial-img" alt="Avatar">
                                        </div>
                                        <div class="flex-grow-1 text-center text-sm-start">
                                            <div class="testimonial-name">@Html.Raw(camNhans[i].TieuDe)</div>
                                            <div class="testimonial-role">@Html.Raw(camNhans[i].TieuDe2)</div>
                                            <div class="testimonial-content">@Html.Raw(camNhans[i].NoiDung)</div>
                                        </div>
                                    </div>
                                </div>
                                @if (i + 1 < camNhans.Count)
                                {
                                    <div class="col-12 col-md-6">
                                        <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start px-3">
                                            <div class="testimonial-img-wrapper mb-3 mb-sm-0">
                                                <img src="@camNhans[i + 1].DuongDanAnh" class="testimonial-img" alt="Avatar">
                                            </div>
                                            <div class="flex-grow-1 text-center text-sm-start">
                                                <div class="testimonial-name">@Html.Raw(camNhans[i + 1].TieuDe)</div>
                                                <div class="testimonial-role">@Html.Raw(camNhans[i + 1].TieuDe2)</div>
                                                <div class="testimonial-content">@Html.Raw(camNhans[i + 1].NoiDung)</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (camNhans.Count > 2)
                {
                    <div class="d-flex justify-content-center mt-5 gap-3">
                        <button class="testimonial-nav-btn shadow" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev"><i class="fas fa-chevron-left"></i></button>
                        <button class="testimonial-nav-btn shadow" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next"><i class="fas fa-chevron-right"></i></button>
                    </div>
                }
            </div>
        </div>
    }

    @if (baoChis.Any())
    {
        <div class="press-section shadow-sm position-relative">
            <h2 class="press-title">BÁO CHÍ NÓI VỀ VIỆN CÔNG NGHỆ VIỆT - HÀN</h2>

            <div id="pressSlider" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner px-md-5">
                    @for (int i = 0; i < baoChis.Count; i += 2)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="row g-4 justify-content-center">
                                @for (int j = i; j < i + 2 && j < baoChis.Count; j++)
                                {
                                    var rawLink = baoChis[j].TieuDe2 ?? "";
                                    var cleanLink = System.Text.RegularExpressions.Regex.Replace(rawLink, "<.*?>", string.Empty).Trim();

                                    <div class="col-12 col-md-6">
                                        <a href="@cleanLink" target="_blank" class="text-decoration-none">
                                            <div class="card press-card">
                                                <div class="press-img-container">
                                                    <img src="@baoChis[j].DuongDanAnh" class="press-img" alt="Báo chí">
                                                </div>
                                                <div class="press-name">
                                                    @Html.Raw(baoChis[j].TieuDe.Replace("<p>", "").Replace("</p>", ""))
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (baoChis.Count > 2)
                {
                    <button class="carousel-control-prev press-control" type="button" data-bs-target="#pressSlider" data-bs-slide="prev" style="left: 0px;">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next press-control" type="button" data-bs-target="#pressSlider" data-bs-slide="next" style="right: 0px;">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                }
            </div>
        </div>
    }

