        /* =======================================================
           HỌA TIẾT PHONG CẢNH HÀN QUỐC (KOREAN LANDSCAPE DIVIDER)
           ======================================================= */
        .korean-landscape-divider {
            width: 100vw;
            height: 180px; /* Độ cao của dải phong cảnh */
            position: relative;
            left: 50%;
            right: 50%;
            margin-left: -50vw;
            margin-right: -50vw;
            margin-top: 60px;
            margin-bottom: 20px;
            background-image: url('/images/korean-landscape.png');
            background-position: bottom center;
            background-repeat: repeat-x;
            background-size: auto 100%;
            z-index: 1;
        }

        @@media (max-width: 768px) {
            .korean-landscape-divider {
                height: 100px;
                margin-top: 40px;
            }
        }
    }

    .advantage-card:hover {
        border-bottom: 4px solid var(--hover-color, #c62828);
    }

        .advantage-card:hover .advantage-icon {
            background-color: var(--hover-color, #c62828) !important;
            color: #fff !important;
        }
</style>

<div id="vluHeroCarousel" class="carousel slide vlu-hero-carousel" data-bs-ride="carousel" data-bs-interval="2000" data-bs-pause="false">
    <div class="carousel-indicators mb-4">
        @for (int i = 0; i < banners.Count; i++)
        {
            <button type="button" data-bs-target="#vluHeroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
        }
    </div>
    <div class="carousel-inner">
        @if (banners.Any())
        {
            for (int i = 0; i < banners.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")"><img src="@banners[i].DuongDanAnh" class="vlu-banner-img" alt="Banner VKIT"></div>
            }
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#vluHeroCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
    <button class="carousel-control-next" type="button" data-bs-target="#vluHeroCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
</div>


@if (!string.IsNullOrEmpty(firstVideoId))
{
    <div class="container my-5 pt-2">
        <div class="video-main-container bg-white p-4 p-md-5 rounded-4 shadow-sm">

            <div class="row mb-5">
                <div class="col-12">
                    <div class="video-player-wrapper position-relative overflow-hidden rounded-4 shadow-sm" style="padding-top: 56.25%; background: #000;">
                        <iframe class="position-absolute top-0 start-0 w-100 h-100 border-0"
                                src="https://www.youtube.com/embed/@firstVideoId?rel=0&autoplay=1&mute=1&loop=1&playlist=@firstVideoId"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen>
                        </iframe>
                    </div>
                    @if (videoLon != null)
                    {
                        <h3 class="fw-bold mt-4 text-center" style="color: #1a237e; text-transform: uppercase;">@videoLon.MoTaNgan</h3>
                    }
                </div>
            </div>

            <hr class="mb-5 text-muted" style="opacity: 0.15;" />

            <!-- 2. GÓC VIDEO VKIT (CÁC VIDEO NHỎ NẰM NGANG Ở DƯỚI) -->
            <div class="row g-4">
                <div class="col-12 mb-2">
                    <h4 class="fw-bold m-0" style="color: #c62828;"><i class="fab fa-youtube"></i> GÓC VIDEO VKIT</h4>
                </div>

                @foreach (var v in videoNhoList)
                {
                    string yId = LấyIdYoutube(v.DuongDanVideo);
                    if (!string.IsNullOrEmpty(yId))
                    {
                        <div class="col-12 col-md-6 col-lg-4">
                            <!-- Đưa lệnh onclick lên div bọc ngoài cùng để click vào đâu cũng chạy -->
                            <div class="position-relative rounded-4 shadow-sm overflow-hidden bg-dark mb-3 video-small-item"
                                 style="padding-top: 56.25%; cursor: pointer;"
                                 id="vid-container-@yId"
                                 onclick="playSmallVideo('@yId')">

                                <!-- Ảnh bìa -->
                                <img src="https://img.youtube.com/vi/@yId/mqdefault.jpg"
                                     class="position-absolute top-0 start-0 w-100 h-100 img-thumbnail-vid"
                                     style="object-fit: cover; transition: transform 0.3s ease;">

                                <!-- Nút Play -->
                                <div class="position-absolute top-50 start-50 translate-middle text-white d-flex align-items-center justify-content-center play-btn-overlay"
                                     style="background: rgba(198, 40, 40, 0.9); width: 55px; height: 55px; border-radius: 50%; box-shadow: 0 5px 15px rgba(0,0,0,0.3); transition: all 0.3s;">
                                    <i class="fas fa-play fa-lg ms-1"></i>
                                </div>
                            </div>

                            <h6 class="fw-bold text-dark mb-1" style="line-height: 1.4;">@v.MoTaNgan</h6>
                            <small class="text-muted"><i class="far fa-clock"></i> @v.NgayTao.ToString("dd/MM/yyyy")</small>
                        </div>
                    }
                }
            </div>

        </div>
    </div>

    <!-- SCRIPT & CSS CHO VIDEO NHỎ -->
    <style>
        /* Hiệu ứng rê chuột xịn xò cho video nhỏ */
        .video-small-item:hover .img-thumbnail-vid {
            transform: scale(1.05);
        }

        .video-small-item:hover .play-btn-overlay {
            background: #ff0000 !important;
            transform: translate(-50%, -50%) scale(1.15);
        }
    </style>

    <script>
        function playSmallVideo(videoId) {
            var container = document.getElementById('vid-container-' + videoId);
            if (container) {
                // Thay thế ảnh bằng Iframe Youtube (có kèm mã autoplay=1 để phát luôn)
                container.innerHTML = '<iframe class="position-absolute top-0 start-0 w-100 h-100 border-0" ' +
                                      'src="https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0" ' +
                                      'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" ' +
                                      'allowfullscreen></iframe>';
            }
        }
    </script>
    <style>
        .video-item-clickable:hover {
            background-color: #ffebee !important;
            transform: translateX(5px);
        }

        .video-list-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .video-list-scroll::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .video-list-scroll::-webkit-scrollbar-thumb {
            background: #c62828;
            border-radius: 10px;
        }
    </style>
}
<div class="container my-5 pt-2">

    <section class="advantages-section py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="section-badge">
                    <i class="fas fa-star"></i> VKIT ADVANTAGES
                </span>
                <h2 class="section-title mt-3"> Ưu Điểm Chương Trình </h2>
                <p class="section-subtitle"> Chương trình đào tạo chuẩn quốc tế, gắn liền doanh nghiệp và cơ hội phát triển toàn diện cho sinh viên. </p>
            </div>

            <div class="row g-4">
                @if (ViewBag.DanhSachUuDiem != null)
                {
                    var listUuDiem = (List<VKITActivityManager.Models.UuDiem>)ViewBag.DanhSachUuDiem;
                    foreach (var item in listUuDiem)
                    {
                        string iconColor = string.IsNullOrEmpty(item.MauNen) ? "#c62828" : item.MauNen;

                        <div class="col-12 col-sm-6 col-lg-3">
                            <!-- Click vào thẻ sẽ chuyển hướng sang trang Chi Tiết -->
                            <a asp-action="ChiTietUuDiem" asp-route-id="@item.Id" class="text-decoration-none text-dark d-block h-100">
                                <div class="advantage-card h-100" style="--hover-color: @iconColor;">
                                    <div class="advantage-icon" style="color: @iconColor; background-color: @(iconColor)1A;">
                                        <i class="@(string.IsNullOrEmpty(item.Icon) ? "fas fa-star" : item.Icon)"></i>
                                    </div>
                                    <h4 class="advantage-title">@item.TenUuDiem</h4>
                                    <p class="advantage-text">@item.NoiDung</p>
                                </div>
                            </a>
                        </div>
                    }
                }
            </div>
        </div>
    </section>

    @{
        var allHocPhi = ViewBag.DanhSachHocPhi as List<VKITActivityManager.Models.HocPhi> ?? new List<VKITActivityManager.Models.HocPhi>();

        var listCuNhan = allHocPhi.Where(x => x.HeDaoTao != "KS").ToList();
        var listKySu = allHocPhi.Where(x => x.HeDaoTao == "KS").ToList();
    }

    <div class="tuition-section">
        <h2 class="fw-bold text-center tuition-title mb-4">
            HỌC PHÍ THAM KHẢO NĂM 2025 VÀ<br />ĐƯỢC TÍNH THEO CHƯƠNG TRÌNH ĐÀO TẠO CHUẨN
        </h2>

        <div class="tuition-tabs-container">
            <ul class="nav nav-pills tuition-tabs" id="tuitionTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="cunhan-tab" data-bs-toggle="tab" data-bs-target="#cunhan" type="button" role="tab">
                        <i class="fas fa-user-graduate me-2"></i> Hệ Cử Nhân
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="kysu-tab" data-bs-toggle="tab" data-bs-target="#kysu" type="button" role="tab">
                        <i class="fas fa-microchip me-2"></i> Hệ Kỹ Sư
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="tuitionTabContent">
            <div class="tab-pane fade show active" id="cunhan" role="tabpanel">
                <div class="tuition-wrapper animate__animated animate__fadeIn">
                    <div class="table-responsive">
                        <table class="table table-bordered tuition-table text-center mb-0" style="min-width: 800px;">
                            <thead>
                                <tr>
                                    <th width="20%">Ngành đào tạo</th>
                                    <th width="15%">Đơn vị áp dụng</th>
                                    <th width="20%">Học phí<br />(VNĐ)</th>
                                    <th width="22%">Học phí sau học bổng 25%<br />(VNĐ)</th>
                                    <th width="23%">Học phí sau học bổng 50%<br />(VNĐ)</th>
                                </tr>
                            </thead>
                            <tbody class="text-center align-middle">
                                @if (listCuNhan.Any())
                                {
                                    var groups = listCuNhan.GroupBy(x => new { x.NganhDaoTao, x.ThoiGian }).ToList();
                                    foreach (var group in groups)
                                    {
                                        var items = group.ToList();
                                        for (int i = 0; i < items.Count; i++)
                                        {
                                            <tr class="@(items[i].LaDongPhu ? "bg-light-red" : "")">
                                                @if (i == 0)
                                                {
                                                    <td rowspan="@items.Count" class="text-dark-blue fw-bold text-start ps-3">
                                                        @group.Key.NganhDaoTao<br />
                                                        <span class="small text-muted fw-normal">(@group.Key.ThoiGian)</span>
                                                    </td>
                                                }
                                                <td class="text-dark-blue fw-bold">@items[i].DonViApDung</td>
                                                <td class="text-blue fw-bold">@items[i].MucHocPhi</td>
                                                <td class="text-red fw-bold">@items[i].HocPhiGiam25</td>
                                                <td class="text-red fw-bold">@items[i].HocPhiGiam50</td>
                                            </tr>
                                        }
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="py-4 text-muted fst-italic">Chưa có thông tin học phí hệ Cử nhân.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="kysu" role="tabpanel">
                <div class="tuition-wrapper animate__animated animate__fadeIn">
                    <div class="table-responsive">
                        <table class="table table-bordered tuition-table text-center mb-0" style="min-width: 800px;">
                            <thead>
                                <tr>
                                    <th width="20%">Ngành đào tạo</th>
                                    <th width="15%">Đơn vị áp dụng</th>
                                    <th width="20%">Học phí<br />(VNĐ)</th>
                                    <th width="22%">Học phí sau học bổng 25%<br />(VNĐ)</th>
                                    <th width="23%">Học phí sau học bổng 50%<br />(VNĐ)</th>
                                </tr>
                            </thead>
                            <tbody class="text-center align-middle">
                                @if (listKySu.Any())
                                {
                                    var groups = listKySu.GroupBy(x => new { x.NganhDaoTao, x.ThoiGian }).ToList();
                                    foreach (var group in groups)
                                    {
                                        var items = group.ToList();
                                        for (int i = 0; i < items.Count; i++)
                                        {
                                            <tr class="@(items[i].LaDongPhu ? "bg-light-red" : "")">
                                                @if (i == 0)
                                                {
                                                    <td rowspan="@items.Count" class="text-dark-blue fw-bold text-start ps-3">
                                                        @group.Key.NganhDaoTao<br />
                                                        <span class="small text-muted fw-normal">(@group.Key.ThoiGian)</span>
                                                    </td>
                                                }
                                                <td class="text-dark-blue fw-bold">@items[i].DonViApDung</td>
                                                <td class="text-blue fw-bold">@items[i].MucHocPhi</td>
                                                <td class="text-red fw-bold">@items[i].HocPhiGiam25</td>
                                                <td class="text-red fw-bold">@items[i].HocPhiGiam50</td>
                                            </tr>
                                        }
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="py-4 text-muted fst-italic">Chưa có thông tin học phí hệ Kỹ sư.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3 mt-5">
        <h2 class="fw-bold m-0" style="color: #1a237e; border-left: 5px solid #f8ca00; padding-left: 15px;">Các Loại Học Bổng Hiện Hành</h2>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-lg-10">
            @if (ViewBag.DanhSachLoaiHocBong != null)
            {
                var dsLoaiHB = (List<VKITActivityManager.Models.LoaiHocBong>)ViewBag.DanhSachLoaiHocBong;

                foreach (var item in dsLoaiHB)
                {
                    string cardColor = !string.IsNullOrEmpty(item.MauNen) ? item.MauNen : "#4a72d4";

                    <div class="hb-premium-card" style="--hb-color: @cardColor;" onclick="window.location.href='@Url.Action("DanhSachSinhVienHocBong", "Home", new { id = item.Id })'">

                        <div class="hb-premium-left">
                            <span class="hb-premium-num">
                                @(item.SoSuat < 10 ? "0" + item.SoSuat : item.SoSuat.ToString())
                            </span>
                            <span class="hb-premium-unit">SUẤT</span>
                        </div>

                        <div class="hb-premium-right">
                            <h4 class="hb-premium-title">
                                @item.TenHocBong
                            </h4>
                            @if (!string.IsNullOrEmpty(item.MoTa))
                            {
                                <p class="hb-premium-desc">
                                    @item.MoTa
                                </p>
                            }
                        </div>

                        <i class="fas fa-chevron-right hb-premium-icon"></i>
                    </div>
                }
            }
        </div>
    </div>

    @if (camNhans.Count > 0)
    {
        <div class="testimonial-section shadow-sm">
            <h2 class="testimonial-title">CẢM NHẬN CỦA SINH VIÊN VỀ CHƯƠNG TRÌNH VIỆT - HÀN</h2>
            <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner px-md-4">
                    @for (int i = 0; i < camNhans.Count; i += 2)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="row g-4 justify-content-center align-items-center">
                                <div class="col-12 col-md-6">
                                    <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start px-3">
                                        <div class="testimonial-img-wrapper mb-3 mb-sm-0">
                                            <img src="@camNhans[i].DuongDanAnh" class="testimonial-img" alt="Avatar">
                                        </div>
                                        <div class="flex-grow-1 text-center text-sm-start">
                                            <div class="testimonial-name">@Html.Raw(camNhans[i].TieuDe)</div>
                                            <div class="testimonial-role">@Html.Raw(camNhans[i].TieuDe2)</div>
                                            <div class="testimonial-content">@Html.Raw(camNhans[i].NoiDung)</div>
                                        </div>
                                    </div>
                                </div>
                                @if (i + 1 < camNhans.Count)
                                {
                                    <div class="col-12 col-md-6">
                                        <div class="d-flex flex-column flex-sm-row align-items-center align-items-sm-start px-3">
                                            <div class="testimonial-img-wrapper mb-3 mb-sm-0">
                                                <img src="@camNhans[i + 1].DuongDanAnh" class="testimonial-img" alt="Avatar">
                                            </div>
                                            <div class="flex-grow-1 text-center text-sm-start">
                                                <div class="testimonial-name">@Html.Raw(camNhans[i + 1].TieuDe)</div>
                                                <div class="testimonial-role">@Html.Raw(camNhans[i + 1].TieuDe2)</div>
                                                <div class="testimonial-content">@Html.Raw(camNhans[i + 1].NoiDung)</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (camNhans.Count > 2)
                {
                    <div class="d-flex justify-content-center mt-5 gap-3">
                        <button class="testimonial-nav-btn shadow" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev"><i class="fas fa-chevron-left"></i></button>
                        <button class="testimonial-nav-btn shadow" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next"><i class="fas fa-chevron-right"></i></button>
                    </div>
                }
            </div>
        </div>
    }

    @if (baoChis.Any())
    {
        <div class="press-section shadow-sm position-relative">
            <h2 class="press-title">BÁO CHÍ NÓI VỀ VIỆN CÔNG NGHỆ VIỆT - HÀN</h2>

            <div id="pressSlider" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner px-md-5">
                    @for (int i = 0; i < baoChis.Count; i += 2)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="row g-4 justify-content-center">
                                @for (int j = i; j < i + 2 && j < baoChis.Count; j++)
                                {
                                    var rawLink = baoChis[j].TieuDe2 ?? "";
                                    var cleanLink = System.Text.RegularExpressions.Regex.Replace(rawLink, "<.*?>", string.Empty).Trim();

                                    <div class="col-12 col-md-6">
                                        <a href="@cleanLink" target="_blank" class="text-decoration-none">
                                            <div class="card press-card">
                                                <div class="press-img-container">
                                                    <img src="@baoChis[j].DuongDanAnh" class="press-img" alt="Báo chí">
                                                </div>
                                                <div class="press-name">
                                                    @Html.Raw(baoChis[j].TieuDe.Replace("<p>", "").Replace("</p>", ""))
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (baoChis.Count > 2)
                {
                    <button class="carousel-control-prev press-control" type="button" data-bs-target="#pressSlider" data-bs-slide="prev" style="left: 0px;">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next press-control" type="button" data-bs-target="#pressSlider" data-bs-slide="next" style="right: 0px;">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                }
            </div>
        </div>
    }

    <div class="training-section shadow-sm mb-5">
        <div class="row">
            <div class="col-lg-4 mb-5 mb-lg-0 pe-lg-4">
                <h2 class="fw-bold mb-4 training-title">Các Ngành &<br /> Khối đào tạo</h2>
                <p class="text-muted mb-4" style="line-height: 1.7; text-align: justify;">VKIT hiện có nhiều khối ngành đào tạo với các chuyên ngành công nghệ và ngôn ngữ khác nhau, trong đó bao gồm nhiều ngành nghề đang được xã hội quan tâm nhất. Chương trình học được thiết kế theo chuẩn quốc tế.</p>
            </div>
            <div class="col-lg-8 border-start-lg ps-lg-4">
                <div class="row g-4">
                    <div class="col-md-6 col-lg-4">
                        <div class="d-flex align-items-start"><i class="fas fa-microchip fs-4 text-danger me-3 mt-1"></i><h5 class="fw-bold category-title mb-0">Khối ngành kỹ thuật</h5></div>
                        <ul class="list-unstyled faculty-list">
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="1">Công nghệ Thông tin</a></li>
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="2">Công nghệ Kỹ thuật Ô tô</a></li>
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="3">Công nghệ Ô Tô Điện</a></li>
                        </ul>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="d-flex align-items-start"><i class="fas fa-chart-line fs-4 text-danger me-3 mt-1"></i><h5 class="fw-bold category-title mb-0">Khối ngành Kinh tế</h5></div>
                        <ul class="list-unstyled faculty-list">
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="4">Quản trị Kinh doanh</a></li>
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="5">Kinh doanh Quốc tế</a></li>
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="6">Marketting</a></li>
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="7">Digital Marketting</a></li>
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="8">Logistics & QLCCU</a></li>
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="9">Tài chính - Ngân Hàng</a></li>
                        </ul>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="d-flex align-items-start"><i class="fas fa-globe fs-4 text-danger me-3 mt-1"></i><h5 class="fw-bold category-title mb-0">Khối ngành Xã hội</h5></div>
                        <ul class="list-unstyled faculty-list">
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="10">Quan hệ Công chúng</a></li>
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="11">Quản trị Khách sạn</a></li>
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="12">Quản trị Du lịch & Lữ hành</a></li>
                            <li><a asp-controller="Home" asp-action="DanhSachHoatDongNganh" asp-route-id="13">Ngôn ngữ Hàn Quốc</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var pressEl = document.querySelector('#pressSlider');
        if (pressEl) {
            var pCarousel = new bootstrap.Carousel(pressEl, {
                interval: 3500,
                wrap: true,
                pause: 'hover'
            });
            pCarousel.cycle();
        }

        var testimonialEl = document.querySelector('#testimonialCarousel');
        if (testimonialEl) {
            var tCarousel = new bootstrap.Carousel(testimonialEl, {
                interval: 3000,
                wrap: true
            });
            tCarousel.cycle();
        }
    });
</script>