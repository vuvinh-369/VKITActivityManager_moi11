                color: #c62828;
            }

            .tuition-tabs .nav-link.active {
                background-color: #c62828;
                color: #fff;
                box-shadow: 0 4px 15px rgba(198, 40, 40, 0.3);
                transform: translateY(-2px);
            }

    .tuition-wrapper {
        border: 2px solid #c62828;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        background: #fff;
    }
    .advantage-card {
        background-color: #ffffff;
        border-radius: 16px;
        padding: 25px 20px;
        height: 100%;
        transition: all 0.3s ease;
        border: 1px solid #f0f0f0;
        border-bottom: 4px solid transparent;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

        .advantage-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08);
            border-bottom: 4px solid #c62828;
        }

    .advantage-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background-color: rgba(198, 40, 40, 0.08);
        color: #c62828;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 18px;
        transition: all 0.3s ease;
    }

    .advantage-card:hover .advantage-icon {
        background-color: #c62828;
        color: #ffffff;
        transform: scale(1.1) rotate(5deg);
    }

    .advantage-title {
        color: #1a237e;
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 12px;
        line-height: 1.4;
    }

    .advantage-text {
        color: #555;
        font-size: 0.9rem;
        line-height: 1.6;
        text-align: justify;
        margin: 0;
    }

    .tuition-section {
        margin: 60px 0;
    }

    .tuition-title {
        color: #c62828;
        font-size: 1.8rem;
        line-height: 1.4;
    }

    .tuition-wrapper {
        border: 2px solid #c62828;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    .tuition-table {
        margin-bottom: 0;
        background-color: #fff;
    }

        .tuition-table thead {
            background-color: #d32f2f;
            color: white;
        }

        .tuition-table th, .tuition-table td {
            padding: 16px;
            border: 1px solid #ffcdd2;
            vertical-align: middle;
        }

    .bg-light-red {
        background-color: #fff8f8;
    }

    .text-blue {
        color: #1976d2;
    }

    .text-red {
        color: #c62828;
    }

    .text-dark-blue {
        color: #1a237e;
    }

    .advantages-section {
        background: linear-gradient(to bottom, #f8fbff, #ffffff);
    }

    .section-badge {
        display: inline-block;
        background: #e8f0ff;
        color: #0d47a1;
        padding: 8px 18px;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .section-title {
        font-size: 42px;
        font-weight: 800;
        color: #1a237e;
    }

    .section-subtitle {
        max-width: 750px;
        margin: auto;
        color: #6c757d;
        font-size: 17px;
        line-height: 1.7;
    }

    .advantage-card {
        background: #fff;
        border-radius: 24px;
        padding: 35px 25px;
        text-align: center;
        transition: all .35s ease;
        border: 1px solid #eef2f7;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(0,0,0,.05);
    }

        .advantage-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg,#0d47a1,#c62828);
        }

        .advantage-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 45px rgba(0,0,0,.12);
        }

    .advantage-icon {
        width: 90px;
        height: 90px;
        margin: auto auto 25px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        color: #fff;
        background: linear-gradient(135deg,#0d47a1,#1565c0);
        box-shadow: 0 10px 25px rgba(13,71,161,.25);
    }

    .advantage-title {
        font-size: 20px;
        font-weight: 700;
        color: #1a237e;
        margin-bottom: 15px;
        min-height: 52px;
    }

    .advantage-text {
        color: #555;
        font-size: 15px;
        line-height: 1.8;
        margin: 0;
    }
    /* MOBILE */ 
  

    {
        .section-title

    {
        font-size: 30px;
    }

    .section-subtitle {
        font-size: 15px;
    }

    .advantage-card {
        padding: 28px 20px;
    }

    .advantage-icon {
        width: 75px;
        height: 75px;
        font-size: 28px;
    }

    }
</style>

<div id="vluHeroCarousel" class="carousel slide vlu-hero-carousel" data-bs-ride="carousel" data-bs-interval="2000" data-bs-pause="false">
    <div class="carousel-indicators mb-4">
        @for (int i = 0; i < banners.Count; i++)
        {
            <button type="button" data-bs-target="#vluHeroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
        }
    </div>
    <div class="carousel-inner">
        @if (banners.Any())
        {
            for (int i = 0; i < banners.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")"><img src="@banners[i].DuongDanAnh" class="vlu-banner-img" alt="Banner VKIT"></div>
            }
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#vluHeroCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
    <button class="carousel-control-next" type="button" data-bs-target="#vluHeroCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
</div>

<div class="container my-5 pt-2">

    @if (videos.Count > 0)
    {
        <div class="row align-items-center video-main-container mb-5 mx-0">
            <div class="col-lg-7 p-0"><div class="video-player-wrapper"><div class="youtube-container"><div id="youtubePlayerAPI"></div></div></div></div>
            <div class="col-lg-5 ps-lg-5 pt-4 pt-lg-0">
                <h6 id="currentVideoSubTitle" class="text-danger fw-bold text-uppercase mb-2">@Html.Raw(videos[0].TieuDe2 ?? videos[0].MoTaNgan)</h6>
                <h3 id="currentVideoTitle" class="fw-bold mb-3" style="color: #1a237e;">@Html.Raw(videos[0].TieuDe)</h3>
                <div id="currentVideoContent" class="text-muted fs-6 video-content-scroll">@Html.Raw(videos[0].NoiDung)</div>
            </div>
        </div>
    }
    <!-- ===================== ƯU ĐIỂM CHƯƠNG TRÌNH ===================== --> 
    <section class="advantages-section py-5"> <div class="container"> 
        <!-- TITLE --> <div class="text-center mb-5"> <span class="section-badge">
            <i class="fas fa-star"></i> VKIT ADVANTAGES </span> <h2 class="section-title mt-3"> Ưu Điểm Chương Trình </h2>
            <p class="section-subtitle"> Chương trình đào tạo chuẩn quốc tế, gắn liền doanh nghiệp và cơ hội phát triển toàn diện cho sinh viên. </p> 
            </div> <!-- CARDS -->
            <div class="row g-4"> <!-- ITEM -->
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="advantage-card h-100"> <div class="advantage-icon"> 
                        <i class="fas fa-users"></i> </div> 
                        <h4 class="advantage-title"> Mô hình chuẩn Hàn Quốc </h4> <p class="advantage-text"> Mô hình đào tạo theo tiêu chuẩn các trường đại học Hàn Quốc, quy mô lớp nhỏ (20-30), tăng cường tương tác. </p>
                    </div>
                </div> <!-- ITEM --> <div class="col-12 col-sm-6 col-lg-3"> <div class="advantage-card h-100"> <div class="advantage-icon"> <i class="fas fa-building"></i> </div> <h4 class="advantage-title"> Trải nghiệm doanh nghiệp </h4>
                        <p class="advantage-text"> Sinh viên được trải nghiệm doanh nghiệp từ năm 1, có cơ hội việc làm từ năm 2. </p>
                    </div>
                </div> <!-- ITEM --> <div class="col-12 col-sm-6 col-lg-3"> <div class="advantage-card h-100"> <div class="advantage-icon"> <i class="fas fa-plane-departure"></i> </div>
                        <h4 class="advantage-title"> Chuyển tiếp du học </h4> <p class="advantage-text"> Được lựa chọn chuyển tiếp để lấy bằng Đại học Hàn Quốc sau 2 năm học tại HUTECH. </p>
                    </div>
                </div> <!-- ITEM --> <div class="col-12 col-sm-6 col-lg-3"> <div class="advantage-card h-100"> <div class="advantage-icon"> <i class="fas fa-globe-asia"></i> </div>
                        <h4 class="advantage-title"> Giảng viên quốc tế </h4> <p class="advantage-text"> Giảng viên tốt nghiệp từ các trường đại học Hàn Quốc, các trường đẳng cấp quốc tế. </p>
                    </div>
                </div> <!-- ITEM --> <div class="col-12 col-sm-6 col-lg-3"> <div class="advantage-card h-100"> <div class="advantage-icon"> <i class="fas fa-wallet"></i> </div>
                        <h4 class="advantage-title"> Thực tập thu nhập cao </h4> <p class="advantage-text"> Thực tập, làm việc trong các doanh nghiệp tại Hàn Quốc hoặc Việt Nam với mức thu nhập xứng đáng. </p>
                    </div>
                </div> <!-- ITEM --> <div class="col-12 col-sm-6 col-lg-3"> <div class="advantage-card h-100"> <div class="advantage-icon"> <i class="fas fa-language"></i> </div>

                        <h4 class="advantage-title"> Ngoại khóa miễn phí </h4> <p class="advantage-text"> Ngoài lịch học chính khóa, sinh viên có thể tham gia các lớp học phụ đạo tiếng Hàn và văn hóa Hàn Quốc ngoài giờ miễn phí. </p>
                    </div>
                </div> <!-- ITEM --> <div class="col-12 col-sm-6 col-lg-3"> <div class="advantage-card h-100"> <div class="advantage-icon"> <i class="fas fa-graduation-cap"></i> </div> <h4 class="advantage-title"> Nhận bằng đại học Hàn </h4>

                        <p class="advantage-text"> Được lựa chọn chuyển tiếp để lấy bằng Đại Học Hàn Quốc sau 2 năm học tại HUTECH.</p>
                    </div>
                </div> <!-- ITEM --> <div class="col-12 col-sm-6 col-lg-3"> <div class="advantage-card h-100"> <div class="advantage-icon"> <i class="fas fa-book-reader"></i> </div> <h4 class="advantage-title"> Dễ dàng tiếp thu kiến thức </h4> <p class="advantage-text"> Sinh viên vẫn học các môn chuyên ngành bằng tiếng Việt để dễ dàng tiếp thu kiến thức. </p> </div> </div>
            </div>
        </div>
    </section>
    @{
        // PHÂN LOẠI CỰC KỲ CHÍNH XÁC DỰA VÀO CỘT HeDaoTao TỪ BẢNG HỌC PHÍ
        var allHocPhi = ViewBag.DanhSachHocPhi as List<VKITActivityManager.Models.HocPhi> ?? new List<VKITActivityManager.Models.HocPhi>();

        // Hệ Cử Nhân (Tất cả những dữ liệu không mang mã KS, hoặc bị rỗng đều tính là Cử nhân)
        var listCuNhan = allHocPhi.Where(x => x.HeDaoTao != "KS").ToList();

        // Hệ Kỹ Sư (Chỉ những dữ liệu được Admin gán đúng mã KS)
        var listKySu = allHocPhi.Where(x => x.HeDaoTao == "KS").ToList();
    }

    <div class="tuition-section">
        <h2 class="fw-bold text-center tuition-title mb-4">
            HỌC PHÍ THAM KHẢO NĂM 2025 VÀ<br />ĐƯỢC TÍNH THEO CHƯƠNG TRÌNH ĐÀO TẠO CHUẨN
        </h2>

        <div class="tuition-tabs-container">
            <ul class="nav nav-pills tuition-tabs" id="tuitionTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="cunhan-tab" data-bs-toggle="tab" data-bs-target="#cunhan" type="button" role="tab">
                        <i class="fas fa-user-graduate me-2"></i> Hệ Cử Nhân
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="kysu-tab" data-bs-toggle="tab" data-bs-target="#kysu" type="button" role="tab">
                        <i class="fas fa-microchip me-2"></i> Hệ Kỹ Sư
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="tuitionTabContent">

            <div class="tab-pane fade show active" id="cunhan" role="tabpanel">
                <div class="tuition-wrapper animate__animated animate__fadeIn">
                    <div class="table-responsive">
                        <table class="table table-bordered tuition-table text-center mb-0" style="min-width: 800px;">
                            <thead>
                                <tr>
                                    <th width="20%">Ngành đào tạo</th>
                                    <th width="15%">Đơn vị áp dụng</th>
                                    <th width="20%">Học phí<br />(VNĐ)</th>
                                    <th width="22%">Học phí sau học bổng 25%<br />(VNĐ)</th>
                                    <th width="23%">Học phí sau học bổng 50%<br />(VNĐ)</th>
                                </tr>
                            </thead>
                            <tbody class="text-center align-middle">
                                @if (listCuNhan.Any())
                                {
                                    var groups = listCuNhan.GroupBy(x => new { x.NganhDaoTao, x.ThoiGian }).ToList();
                                    foreach (var group in groups)
                                    {
                                        var items = group.ToList();
                                        for (int i = 0; i < items.Count; i++)
                                        {
                                            <tr class="@(items[i].LaDongPhu ? "bg-light-red" : "")">
                                                @if (i == 0)
                                                {
